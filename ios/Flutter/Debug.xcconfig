#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Workaround for flutter/flutter#188461: Xcode 27's lipo -verify_arch accepts
// only one architecture per call, so universal simulator builds fail during
// unwrap. Build the arm64 slice only (Xcode's default on Apple Silicon).
ARCHS = arm64
